<idea-plugin>
    <id>com.github.studyzy.codei18n-jetbrains</id>
    <name>CodeI18n</name>
    <vendor email="support@example.com" url="https://github.com/studyzy/codei18n-jetbrains">CodeI18n Team</vendor>

    <description><![CDATA[
    Internationalization for code comments.<br>
    Display translated comments in your IDE without modifying the source code.<br>
    Supports: Go (.go), Rust (.rs)
    ]]></description>

    <!-- please see https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html
         on how to target different products -->
    <depends>com.intellij.modules.platform</depends>
    <!-- Go 插件依赖设为可选，支持在 RustRover 中运行 -->
    <depends optional="true" config-file="go-support.xml">org.jetbrains.plugins.go</depends>
    <!-- Rust 插件依赖设为可选，支持在 GoLand 中运行 -->
    <!-- RustRover 中 Rust 插件的 ID 是 com.jetbrains.rust -->
    <depends optional="true" config-file="rust-support.xml">com.jetbrains.rust</depends>

    <projectListeners>
        <listener class="com.github.studyzy.codei18n.listeners.FileOpenListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
    
    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.github.studyzy.codei18n.utils.ProcessExecutor"/>
        <applicationConfigurable
            parentId="tools"
            instance="com.github.studyzy.codei18n.settings.PluginSettingsConfigurable"
            id="com.github.studyzy.codei18n.settings.PluginSettingsConfigurable"
            displayName="CodeI18n"/>
    </extensions>

    <actions>
        <!-- Add your actions here -->
    </actions>
</idea-plugin>