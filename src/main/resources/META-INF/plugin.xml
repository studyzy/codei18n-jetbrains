<idea-plugin>
    <id>com.github.studyzy.codei18n-jetbrains</id>
    <name>CodeI18n</name>
    <vendor email="support@example.com" url="https://github.com/studyzy/codei18n-jetbrains">CodeI18n Team</vendor>

    <description><![CDATA[
    Internationalization for code comments.<br>
    Display translated comments in your IDE without modifying the source code.
    ]]></description>

    <!-- please see https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html
         on how to target different products -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.go</depends>

    <projectListeners>
        <listener class="com.github.studyzy.codei18n.listeners.FileOpenListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
    
    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.github.studyzy.codei18n.utils.ProcessExecutor"/>
        <applicationConfigurable
            parentId="tools"
            instance="com.github.studyzy.codei18n.settings.PluginSettingsConfigurable"
            id="com.github.studyzy.codei18n.settings.PluginSettingsConfigurable"
            displayName="CodeI18n"/>
        
        <!-- 注释翻译折叠构建器：折叠英文注释，显示中文翻译 -->
        <lang.foldingBuilder
            language="go"
            implementationClass="com.github.studyzy.codei18n.providers.CommentTranslationFoldingBuilder"
            order="first"/>
        
        <!-- 注释文档提供者：鼠标悬停时显示英文原文 -->
        <lang.documentationProvider
            language="go"
            implementationClass="com.github.studyzy.codei18n.providers.CommentDocumentationProvider"
            order="first"/>
        
        <!-- 注释翻译注解器（已禁用，改用 Folding 方式）
        <annotator
            language="go"
            implementationClass="com.github.studyzy.codei18n.providers.CommentTranslationAnnotator"/>
        -->
        
        <!-- Inlay Hints 方式（已禁用，改用 Folding 方式）
        <codeInsight.inlayProvider
            language="go"
            implementationClass="com.github.studyzy.codei18n.providers.TranslationInlayHintsProvider"/>
        -->
    </extensions>

    <actions>
        <!-- Add your actions here -->
    </actions>
</idea-plugin>
